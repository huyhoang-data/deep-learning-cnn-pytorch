import torch
import torch.nn as nn
import torch.optim as optim
import torchvision
import torchvision.transforms as transforms
import matplotlib.pyplot as plt
import numpy as np

# Định nghĩa cấu trúc mạng CNN
class SimpleCNN(nn.Module):
    def __init__(self):
        super(SimpleCNN, self).__init__()
        self.features = nn.Sequential(
            nn.Conv2d(3, 32, kernel_size=3, padding=1),
            nn.ReLU(),
            nn.MaxPool2d(2, 2),
            nn.Conv2d(32, 64, kernel_size=3, padding=1),
            nn.ReLU(),
            nn.MaxPool2d(2, 2)
        )
        self.classifier = nn.Sequential(
            nn.Flatten(),
            nn.Linear(64 * 8 * 8, 64),
            nn.ReLU(),
            nn.Linear(64, 10)
        )

    def forward(self, x):
        return self.classifier(self.features(x))

# Hàm hỗ trợ hiển thị ảnh
def imshow(img):
    img = img / 2 + 0.5     # Unnormalize
    npimg = img.numpy()
    plt.imshow(np.transpose(npimg, (1, 2, 0)))
    plt.show()

if __name__ == '__main__':
    # 1. Tải và tiền xử lý dữ liệu CIFAR-10
    transform = transforms.Compose([
        transforms.ToTensor(),
        transforms.Normalize((0.5, 0.5, 0.5), (0.5, 0.5, 0.5))
    ])

    print("Đang tự động tải bộ dữ liệu CIFAR-10 từ Internet...")
    trainset = torchvision.datasets.CIFAR10(root='./data', train=True, download=True, transform=transform)
    # Đặt num_workers=0 để tránh lỗi BrokenPipeError trên macOS
    trainloader = torch.utils.data.DataLoader(trainset, batch_size=64, shuffle=True, num_workers=0)

    testset = torchvision.datasets.CIFAR10(root='./data', train=False, download=True, transform=transform)
    testloader = torch.utils.data.DataLoader(testset, batch_size=64, shuffle=False, num_workers=0)

    # Kích hoạt chip Apple Silicon (MPS)
    device = torch.device("mps" if torch.backends.mps.is_available() else "cpu")
    model = SimpleCNN().to(device)

    # 3. Thiết lập hàm Loss và Optimizer
    criterion = nn.CrossEntropyLoss()
    optimizer = optim.Adam(model.parameters(), lr=0.001)

    # 4. Vòng lặp huấn luyện (Training Loop)
    print(f"Bắt đầu huấn luyện mạng CNN trên thiết bị: {device}")
    for epoch in range(5):
        running_loss = 0.0
        for i, (inputs, labels) in enumerate(trainloader, 0):
            inputs, labels = inputs.to(device), labels.to(device)
            optimizer.zero_grad()
            outputs = model(inputs)
            loss = criterion(outputs, labels)
            loss.backward()
            optimizer.step()
            running_loss += loss.item()
        print(f"Chu kỳ {epoch+1}/5 - Độ lỗi (Loss): {running_loss/len(trainloader):.4f}")

    # 5. Kiểm tra độ chính xác trên tập Test
    correct, total = 0, 0
    with torch.no_grad():
        for images, labels in testloader:
            images = images.to(device)
            labels = labels.to(device)
            outputs = model(images)
            _, predicted = torch.max(outputs.data, 1)
            total += labels.size(0)
            correct += (predicted == labels).sum().item()

    print(f"\nĐộ chính xác hoàn thành bài tập (Test Accuracy): {100 * correct / total:.2f}%\n")

    # 6. Trực quan hóa kết quả dự đoán
    classes = ('plane', 'car', 'bird', 'cat', 'deer', 'dog', 'frog', 'horse', 'ship', 'truck')

    dataiter = iter(testloader)
    images, labels = next(dataiter)

    outputs = model(images.to(device))
    _, predicted = torch.max(outputs, 1)

    print('Nhãn thực tế (GroundTruth): ', ' '.join(f'{classes[labels[j]]:5s}' for j in range(4)))
    print('AI dự đoán (Predicted)   : ', ' '.join(f'{classes[predicted[j]]:5s}' for j in range(4)))

    # 7. Lưu file trọng số
    torch.save(model.state_dict(), 'cifar10_cnn.pth')
    print("\nĐã lưu mô hình thành công vào file cifar10_cnn.pth!")

    # Hiển thị cửa sổ hình ảnh
    imshow(torchvision.utils.make_grid(images[:4]))